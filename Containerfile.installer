FROM quay.io/fedora/fedora-bootc:44

ARG ARENAOS_IMAGE=localhost/arenaos:latest

# Fedora's Anaconda environment provides the interactive disk picker.
RUN dnf5 install -y \
      anaconda \
      anaconda-install-img-deps \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      net-tools \
      grub2-efi-x64-cdboot \
      python3-mako \
      lorax-templates-* \
      biosdevname \
      prefixdevname \
      plymouth \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      xorrisofs \
      squashfs-tools \
      jq \
    && dnf5 clean all

RUN mkdir -p /boot/efi \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi \
    && mkdir -p /var/mnt /usr/share/anaconda \
    && printf 'bootc --source-imgref containers-storage:%s --target-imgref %s\n' \
         "${ARENAOS_IMAGE}" "${ARENAOS_IMAGE}" \
         > /usr/share/anaconda/interactive-defaults.ks

# Prepare Anaconda's live environment as required by Fedora's bootc installer.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd \
    && echo "install::14438:0:99999:7:::" >> /etc/shadow \
    && passwd -d root \
    && mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /etc/yum.repos.d /etc/anaconda.repos.d \
    && ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator \
    && ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d \
    && printf '[Login]\nReserveVT=2\n' \
         > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir "$(realpath /root)" \
    && kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version')" \
    && DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
         --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"
